module fifomem 
#(parameter WIDTH   = 8,
  parameter DEPTH   = 16,
  parameter ADDRESS = 4
)(
input [WIDTH-1:0] wdata,
input wclken,wclk,
input [ADDRESS-1:0] waddr,raddr, 
output reg [WIDTH-1:0] rdata);  

reg [WIDTH-1:0] RAM [DEPTH-1:0] ; 

assign rdata = RAM[raddr] ; 

always@(posedge wclk) begin 
if(wclken) RAM[wddr] <= wdata; 
end 

endmodule 




